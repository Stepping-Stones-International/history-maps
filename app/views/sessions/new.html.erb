<% content_for :title, "Sign in" %>

<main class="page page--narrow">
  <header class="page__header">
    <h1 class="page__title">Sign in</h1>
  </header>

  <%# Kept as <div> — the generated controller tests assert on div flashes. %>
  <% if flash[:alert] %>
    <div class="flash flash--alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="flash flash--notice"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: session_path, class: "form" do |form| %>
    <div class="form__field">
      <%= form.label :email_address, "Email address", class: "form__label" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address], class: "form__input" %>
    </div>

    <div class="form__field">
      <%= form.label :password, "Password", class: "form__label" %>
      <%= form.password_field :password, required: true,
            autocomplete: "current-password", maxlength: 72, class: "form__input" %>
    </div>

    <%= form.submit "Sign in", class: "button" %>
  <% end %>

  <p class="page__footnote"><%= link_to "Forgot password?", new_password_path %></p>
</main>
