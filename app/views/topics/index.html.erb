<% content_for :title, "Topics" %>

<main class="page">
  <header class="page__header">
    <h1 class="page__title">Topics</h1>

    <%= link_to new_topic_path, class: "icon-button icon-button--large",
          title: "Add new topic", "aria-label": "Add new topic" do %>
      <%= lucide_icon "plus", class: "icon-button__glyph" %>
    <% end %>
  </header>

  <% if @topics.any? %>
    <ul class="topic-list">
      <% @topics.each do |topic| %>
        <li class="topic">
          <h2 class="topic__title"><%= topic.title %></h2>
          <p class="topic__description"><%= topic.description %></p>
          <p class="topic__author">by <%= topic.author.email_address %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="page__empty">No topics yet.</p>
  <% end %>
</main>
