{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "yarn build:app && yarn build:maplibre-worker",
    "build:app": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:maplibre-worker": "esbuild node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs --bundle --format=esm --outfile=app/assets/builds/maplibre-gl-worker.js"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@inertiajs/react": "^3.6.1",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "volta": {
    "node": "22.19.0"
  }
}
