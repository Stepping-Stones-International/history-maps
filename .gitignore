# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and temporary files.
/log/*
/tmp/
!/log/.keep

# Local development databases; keep schema.rb and migrations versioned.
/db/*.sqlite3
/db/*.sqlite
/db/*.db
*.sqlite3
*.sqlite
*.db

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep

/public/assets

# Historical map data packs are external content, not application code.
/app/assets/data/*
!/app/assets/data/.gitkeep

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# Ignore SimpleCov coverage reports.
/coverage

# Python bytecode from the extract scripts
__pycache__/
*.pyc
